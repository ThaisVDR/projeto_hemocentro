# Copie para .env.local e ajuste conforme o seu ambiente.

# Endereço do Backend-Hemocentro
VUE_APP_API_URL=http://localhost:3000

# true = login simulado, sem backend (senha: Senha123) | false = usa as rotas /auth do backend
VUE_APP_AUTH_MOCK=true

# true = todas as telas exigem login | false = telas abrem sem login (desenvolvimento)
VUE_APP_EXIGIR_LOGIN=false